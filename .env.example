# ==============================================================
# TechStock-AI — Environment Variables Template
# Copy to .env and fill in real values before running
# ==============================================================

# ── Frontend ──────────────────────────────────────────────────
# Django backend URL (port 8000). Change to Railway/Render URL in production
VITE_API_URL=http://localhost:8000

# ── Flask Legacy Backend (port 5000) ──────────────────────────
FLASK_ENV=development
DEBUG=True

# Gemini AI (Get free key from: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Auth
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# ── Django Backend (port 8000) ────────────────────────────────
# Leave blank for SQLite (dev). Set Neon PostgreSQL URL for production:
# DATABASE_URL=postgresql://user:password@neon-host:5432/techstock
DATABASE_URL=

# Django secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=your_django_secret_key_here

# Allowed frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
